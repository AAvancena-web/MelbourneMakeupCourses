{%- comment -%}
  Renders an image from a theme-editor picker, falling back to the asset
  bundled with this pack so every section looks right the moment it is added.

  {% render 'tba-image',
       image: section.settings.hero_image,   (image_picker value, may be blank)
       fallback: 'tba-banner1.webp',         (filename in assets/)
       alt: 'Alt text',
       width: 2000, height: 763,            (used for the width/height attrs)
       url_width: 2000,                     (px requested from Shopify's CDN)
       class: 'tba-course__img',
       loading: 'lazy',
       fetchpriority: 'high' %}
{%- endcomment -%}
{%- liquid
  assign tba_url_width = url_width | default: 1600
  if image != blank
    assign tba_src = image | image_url: width: tba_url_width
    assign tba_w = width | default: image.width
    assign tba_h = height | default: image.height
  else
    assign tba_src = fallback | asset_url
    assign tba_w = width
    assign tba_h = height
  endif
-%}
<img src="{{ tba_src }}" alt="{{ alt | default: '' | escape }}"
  {%- if class %} class="{{ class }}"{% endif %}
  {%- if tba_w %} width="{{ tba_w }}"{% endif %}
  {%- if tba_h %} height="{{ tba_h }}"{% endif %}
  {%- if loading %} loading="{{ loading }}"{% endif %}
  {%- if fetchpriority %} fetchpriority="{{ fetchpriority }}"{% endif %}>
