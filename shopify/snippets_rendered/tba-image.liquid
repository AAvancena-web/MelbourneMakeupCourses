{%- comment -%}
  Renders an image from a theme-editor picker, falling back to the asset
  bundled with this pack so every section looks right the moment it is added.

  width and height are ALWAYS emitted so the browser reserves the right box
  before the file arrives (no layout shift) and Theme Check's
  ImgWidthAndHeight rule passes. When a picker image is chosen its own
  dimensions are used; otherwise pass the bundled file's dimensions.

  {% render 'tba-image',
       image: section.settings.hero_image,   (image_picker value, may be blank)
       fallback: 'tba-banner1.webp',         (filename in Content > Files)
       alt: 'Alt text',
       width: 2000, height: 763,             (the bundled file's real size)
       url_width: 2000,                      (px requested from Shopify's CDN)
       class: 'tba-course__img',
       loading: 'lazy',
       fetchpriority: 'high' %}
{%- endcomment -%}
{%- liquid
  assign tba_url_width = url_width | default: 1600

  if image != blank
    assign tba_src = image | image_url: width: tba_url_width
    assign tba_w = width | default: image.width
    assign tba_h = height | default: image.height
  else
    comment
      Bundled images live in Content > Files, so file_url is the primary source.
      asset_url is emitted as data-tba-fallback and swapped in by
      tba-redesign.js if the file turns out to be in the theme's assets/ folder
      instead — so the pack works either way, with no code edit.
    endcomment
    assign tba_src = fallback | file_url
    assign tba_alt_src = fallback | asset_url
    assign tba_w = width
    assign tba_h = height
  endif

  comment
    Last resort — a block whose dimension fields were left empty. A square
    placeholder ratio only holds until the file loads, at which point
    height:auto takes over from the image's own dimensions.
  endcomment
  assign tba_w = tba_w | plus: 0
  assign tba_h = tba_h | plus: 0
  if tba_w <= 0
    assign tba_w = tba_url_width
  endif
  if tba_h <= 0
    assign tba_h = tba_url_width
  endif
-%}
<img src="{{ tba_src }}" alt="{{ alt | default: '' | escape }}" width="{{ tba_w }}" height="{{ tba_h }}"
  {%- if tba_alt_src %} data-tba-fallback="{{ tba_alt_src }}"{% endif %}
  {%- if class %} class="{{ class }}"{% endif %}
  {%- if loading %} loading="{{ loading }}"{% endif %}
  {%- if fetchpriority %} fetchpriority="{{ fetchpriority }}"{% endif %}>
