{%- comment -%}
  Page header — eyebrow, heading, rule and intro copy. Shared by the
  Bridal Enquiry and Makeup & Tan Services pages.
{%- endcomment -%}
{%- assign s = section.settings -%}
<div class="tba-scope">
<section class="tba-section {{ s.background }}">
  <div class="tba-shell">
    <div class="tba-pageintro">
      {%- if s.eyebrow != blank -%}<p class="tba-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h1 class="tba-h-xl">{{ s.heading }}</h1>
      <hr class="tba-rule tba-rule--center">
      {%- if s.intro != blank -%}<p class="tba-lede">{{ s.intro }}</p>{%- endif -%}
      {%- if s.body != blank -%}<p class="tba-lede">{{ s.body }}</p>{%- endif -%}
      {%- if s.highlight != blank -%}<p class="tba-pageintro__price">{{ s.highlight }}</p>{%- endif -%}
    </div>
  </div>
</section>
</div>

{% schema %}
{
  "name": "TBA page intro",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "intro", "label": "Intro paragraph" },
    { "type": "textarea", "id": "body", "label": "Second paragraph" },
    { "type": "text", "id": "highlight", "label": "Highlight line",
      "info": "Shown in a gold panel under the copy — e.g. a starting price." },
    { "type": "select", "id": "background", "label": "Background",
      "options": [
        { "value": "", "label": "White" },
        { "value": "tba-section--cream", "label": "Cream" },
        { "value": "tba-section--blush", "label": "Blush" },
        { "value": "tba-section--sand", "label": "Sand" }
      ],
      "default": "" }
  ],
  "presets": [{ "name": "TBA page intro" }]
}
{% endschema %}
