{%- comment -%}
  Gold announcement bar — socials left, award line centre, phone + login right.
  Render this in layout/theme.liquid, immediately inside <body>, before the header.
{%- endcomment -%}
{%- assign s = section.settings -%}
<div class="tba-scope">
  <div class="tba-announce">
    <div class="tba-shell">
      <ul class="tba-socials tba-announce__social">
        {%- if s.facebook != blank -%}
          <li><a href="{{ s.facebook }}" target="_blank" rel="noopener me" aria-label="{{ shop.name | escape }} on Facebook"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H8v3h2v7h3v-7h3l1-3h-4v-2c0-.6.4-1 1-1z"/></svg></a></li>
        {%- endif -%}
        {%- if s.instagram != blank -%}
          <li><a href="{{ s.instagram }}" target="_blank" rel="noopener me" aria-label="{{ shop.name | escape }} on Instagram"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="3.6"/><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"/></svg></a></li>
        {%- endif -%}
      </ul>

      <p class="tba-announce__text"><strong>{{ s.message }}</strong></p>

      <div class="tba-announce__links">
        {%- if s.phone != blank -%}
          <a href="tel:{{ s.phone | remove: ' ' }}">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15 15 0 006.6 6.6l2.2-2.2a1 1 0 011-.24 11.4 11.4 0 003.6.57 1 1 0 011 1v3.5a1 1 0 01-1 1A17 17 0 013 5a1 1 0 011-1h3.5a1 1 0 011 1 11.4 11.4 0 00.57 3.55 1 1 0 01-.24 1.05z"/></svg>
            {{ s.phone }}
          </a>
        {%- endif -%}
        {%- if s.show_login -%}
          <a href="{{ routes.account_login_url }}">{{ s.login_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TBA announcement bar",
  "settings": [
    { "type": "text", "id": "message", "label": "Announcement",
      "default": "Awarded Top 4 Education Facility in Australia by the MAGAP (Asia Pacific)" },
    { "type": "text", "id": "phone", "label": "Phone number", "default": "0421 864 557" },
    { "type": "checkbox", "id": "show_login", "label": "Show account login link", "default": true },
    { "type": "text", "id": "login_label", "label": "Login link text", "default": "Login" },
    { "type": "header", "content": "Social" },
    { "type": "text", "id": "facebook", "label": "Facebook URL",
      "default": "https://www.facebook.com/tamaruabeautyacademy/" },
    { "type": "text", "id": "instagram", "label": "Instagram URL",
      "default": "https://www.instagram.com/tamaruabeautyacademy" }
  ],
  "presets": [{ "name": "TBA announcement bar" }]
}
{% endschema %}
