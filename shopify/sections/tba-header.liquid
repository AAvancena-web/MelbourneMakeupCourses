{% schema %}
{
  "name": "TBA header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo",
      "info": "Falls back to the theme logo, then to the bundled wordmark." },
    { "type": "text", "id": "phone", "label": "Phone number", "default": "0421 864 557" },
    { "type": "text", "id": "cta_label", "label": "Header button text", "default": "Book A Free Consultation" },
    { "type": "header", "content": "Courses mega menu images" },
    { "type": "image_picker", "id": "mega_img_1", "label": "Make Up Courses" },
    { "type": "image_picker", "id": "mega_img_2", "label": "Hair Styling Courses" },
    { "type": "image_picker", "id": "mega_img_3", "label": "Nails Courses" },
