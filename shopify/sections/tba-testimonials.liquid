{%- comment -%}
  Testimonial quotes — three across, one block each.
{%- endcomment -%}
{%- assign s = section.settings -%}
<div class="tba-scope">
<section class="tba-section {{ s.background }}" {% if s.anchor != blank %}id="{{ s.anchor }}"{% endif %}>
  <div class="tba-shell">
    <div class="tba-center" style="margin-bottom:clamp(32px,3.6vw,52px)">
      {%- if s.eyebrow != blank -%}<p class="tba-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="tba-h-lg">{{ s.heading }}</h2>{%- endif -%}
      <hr class="tba-rule tba-rule--center">
      {%- if s.lede != blank -%}<p class="tba-lede">{{ s.lede }}</p>{%- endif -%}
    </div>
    <div class="tba-quotes">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <figure class="tba-quote" {{ block.shopify_attributes }}>
          {%- if b.stars > 0 -%}
            <div class="tba-stars" role="img" aria-label="Rated {{ b.stars }} out of 5 stars">
              {%- for i in (1..b.stars) -%}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.6 5.6L21 8.5l-4.5 4.4 1.1 6.2L12 16.2 6.4 19.1l1.1-6.2L3 8.5l6.4-.9L12 2z"/></svg>{%- endfor -%}
            </div>
          {%- endif -%}
          <blockquote>{{ b.quote }}</blockquote>
          <figcaption>
            <cite>{{ b.name }}</cite>
            {%- if b.detail != blank -%}<span>{{ b.detail }}</span>{%- endif -%}
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
    {%- if s.cta_label != blank -%}
      <div class="tba-center" style="margin-top:clamp(30px,3.4vw,48px)">
        <a class="tba-btn tba-btn--ghost" href="{{ s.cta_url | default: '#enquire' }}">{{ s.cta_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>
</div>

{% schema %}
{
  "name": "TBA testimonials",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Intro line"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        {
          "value": "",
          "label": "White"
        },
        {
          "value": "tba-section--cream",
          "label": "Cream"
        },
        {
          "value": "tba-section--blush",
          "label": "Blush"
        },
        {
          "value": "tba-section--sand",
          "label": "Sand"
        }
      ],
      "default": "tba-section--cream"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button text"
    },
    {
      "type": "text",
      "id": "cta_url",
      "label": "Button link",
      "default": "#enquire"
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Detail",
          "info": "Venue and date, or how they booked."
        },
        {
          "type": "range",
          "id": "stars",
          "label": "Stars",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TBA testimonials"
    }
  ]
}
{% endschema %}
