{%- comment -%}
  Image grid. Each image is a block, so the count and order are editable.
{%- endcomment -%}
{%- assign s = section.settings -%}
<div class="tba-scope">
<section class="tba-section {{ s.background }}" {% if s.anchor != blank %}id="{{ s.anchor }}"{% endif %}>
  <div class="tba-shell">
    {%- if s.heading != blank or s.eyebrow != blank -%}
      <div class="tba-center" style="margin-bottom:clamp(30px,3.4vw,48px)">
        {%- if s.eyebrow != blank -%}<p class="tba-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="tba-h-lg">{{ s.heading }}</h2>{%- endif -%}
        <hr class="tba-rule tba-rule--center">
        {%- if s.lede != blank -%}<p class="tba-lede">{{ s.lede }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="tba-gallery{% if s.columns != '4' %} tba-gallery--{{ s.columns }}{% endif %}">
      {%- for block in section.blocks -%}
        <figure {{ block.shopify_attributes }}>
          {% render 'tba-image', image: block.settings.image, fallback: block.settings.fallback,
             alt: block.settings.alt, width: block.settings.width, height: block.settings.height,
             url_width: 800, loading: 'lazy' %}
        </figure>
      {%- endfor -%}
    </div>
    {%- if s.note != blank -%}
      <p class="tba-lede tba-center" style="margin-top:26px;font-size:14.5px">{{ s.note }}</p>
    {%- endif -%}
  </div>
</section>
</div>

{% schema %}
{
  "name": "TBA gallery",
  "max_blocks": 24,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Intro line"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note under the grid"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        {
          "value": "2",
          "label": "Two"
        },
        {
          "value": "3",
          "label": "Three"
        },
        {
          "value": "4",
          "label": "Four"
        }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        {
          "value": "",
          "label": "White"
        },
        {
          "value": "tba-section--cream",
          "label": "Cream"
        },
        {
          "value": "tba-section--blush",
          "label": "Blush"
        },
        {
          "value": "tba-section--sand",
          "label": "Sand"
        }
      ],
      "default": ""
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "fallback",
          "label": "Bundled image",
          "info": "Filename in Content > Files (or the theme's assets/) used when none is chosen."
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        },
        {
          "type": "text",
          "id": "width",
          "label": "Bundled image width",
          "default": "400"
        },
        {
          "type": "text",
          "id": "height",
          "label": "Bundled image height",
          "default": "400"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TBA gallery"
    }
  ]
}
{% endschema %}
