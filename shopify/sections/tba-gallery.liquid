{%- comment -%}
  Image grid, or a full-bleed ribbon sliding right to left. Each image is a
  block, so the count and order are editable.

  The sliding layout reuses the same .tba-marquee mechanics as the reviews
  row: tba-redesign.js clones the track once so the -50% keyframe loops
  seamlessly, and paces it by content width so the speed holds however many
  images there are. It pauses on hover and stops entirely under
  prefers-reduced-motion, where the row becomes a normal scroller.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign sliding = false -%}
{%- if s.layout == 'slide' -%}{%- assign sliding = true -%}{%- endif -%}
<div class="tba-scope">
<section class="tba-section {{ s.background }}" {% if s.anchor != blank %}id="{{ s.anchor }}"{% endif %}>
  {%- if s.heading != blank or s.eyebrow != blank -%}
    <div class="tba-shell">
      <div class="tba-center" style="margin-bottom:clamp(30px,3.4vw,48px)">
        {%- if s.eyebrow != blank -%}<p class="tba-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="tba-h-lg">{{ s.heading }}</h2>{%- endif -%}
        <hr class="tba-rule tba-rule--center">
        {%- if s.lede != blank -%}<p class="tba-lede">{{ s.lede }}</p>{%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- capture frames -%}
    {%- for block in section.blocks -%}
      <figure {{ block.shopify_attributes }}>
        {% render 'tba-image', image: block.settings.image, fallback: block.settings.fallback,
           alt: block.settings.alt, width: block.settings.width, height: block.settings.height,
           url_width: 800, loading: 'lazy' %}
      </figure>
    {%- endfor -%}
  {%- endcapture -%}

  {%- if sliding -%}
    <div class="tba-marquee">
      <div class="tba-marquee__track tba-gallery tba-gallery--slide" data-tba-speed="{{ s.speed }}">
        {{ frames }}
      </div>
    </div>
  {%- else -%}
    <div class="tba-shell">
      <div class="tba-gallery{% if s.columns != '4' %} tba-gallery--{{ s.columns }}{% endif %}">
        {{ frames }}
      </div>
    </div>
  {%- endif -%}

  {%- if s.note != blank -%}
    <div class="tba-shell">
      <p class="tba-lede tba-center" style="margin-top:26px;font-size:14.5px">{{ s.note }}</p>
    </div>
  {%- endif -%}
</section>
</div>

{% schema %}
{
  "name": "TBA gallery",
  "max_blocks": 24,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Intro line"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note under the images"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "slide",
          "label": "Sliding row (right to left)"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "info": "Grid layout only.",
      "options": [
        {
          "value": "2",
          "label": "Two"
        },
        {
          "value": "3",
          "label": "Three"
        },
        {
          "value": "4",
          "label": "Four"
        }
      ],
      "default": "4"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Slide speed",
      "info": "Pixels per second. Sliding layout only.",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 45
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        {
          "value": "",
          "label": "White"
        },
        {
          "value": "tba-section--cream",
          "label": "Cream"
        },
        {
          "value": "tba-section--blush",
          "label": "Blush"
        },
        {
          "value": "tba-section--sand",
          "label": "Sand"
        }
      ],
      "default": ""
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "fallback",
          "label": "Bundled image",
          "info": "Filename in Content > Files (or the theme's assets/) used when none is chosen."
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        },
        {
          "type": "text",
          "id": "width",
          "label": "Bundled image width",
          "default": "400"
        },
        {
          "type": "text",
          "id": "height",
          "label": "Bundled image height",
          "default": "400"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TBA gallery"
    }
  ]
}
{% endschema %}
