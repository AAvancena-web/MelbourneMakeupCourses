{%- comment -%}
  Black footer: brand column, link columns (each one a block), contact column
  and the copyright strip. Render this in layout/theme.liquid in place of the
  theme's own footer section.

  Each link column takes one link per line in the form:  Label | /url
{%- endcomment -%}
{%- assign s = section.settings -%}
<div class="tba-scope">
<footer class="tba-footer">
  <div class="tba-shell">
    <div class="tba-footer__grid">

      <div class="tba-footer__col tba-footer__col--brand">
        <h4>{{ s.brand_heading }}</h4>
        {% render 'tba-logo', logo: s.logo, class: 'tba-footer__brand' %}
        <p style="font-size:14px;line-height:1.8">{{ s.blurb }}</p>
        <ul class="tba-socials" style="list-style:none;margin:20px 0 0;padding:0">
          {%- if s.facebook != blank -%}
            <li><a href="{{ s.facebook }}" target="_blank" rel="noopener me" aria-label="Facebook"><svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H8v3h2v7h3v-7h3l1-3h-4v-2c0-.6.4-1 1-1z"/></svg></a></li>
          {%- endif -%}
          {%- if s.instagram != blank -%}
            <li><a href="{{ s.instagram }}" target="_blank" rel="noopener me" aria-label="Instagram"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="3.6"/><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"/></svg></a></li>
          {%- endif -%}
        </ul>
      </div>

      {%- for block in section.blocks -%}
        <div class="tba-footer__col" {{ block.shopify_attributes }}>
          <h4 data-facc>{{ block.settings.heading }} <span class="tba-footer__acc"><svg width="10" height="7" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M1 1l4 4 4-4"/></svg></span></h4>
          <ul class="tba-footer__menu">
            {%- assign lines = block.settings.links | newline_to_br | split: '<br />' -%}
            {%- for line in lines -%}
              {%- assign parts = line | split: '|' -%}
              {%- assign label = parts[0] | strip -%}
              {%- assign href = parts[1] | strip -%}
              {%- if label != blank -%}
                <li><a href="{{ href | default: '#' }}">{{ label }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}

      <div class="tba-footer__col">
        <h4>{{ s.contact_heading }}</h4>
        <ul>
          {%- if s.phone != blank -%}<li><a href="tel:{{ s.phone | remove: ' ' }}">{{ s.phone }}</a></li>{%- endif -%}
          {%- if s.email != blank -%}<li><a href="mailto:{{ s.email }}">{{ s.email }}</a></li>{%- endif -%}
          {%- if s.address != blank -%}<li>{{ s.address | newline_to_br }}</li>{%- endif -%}
        </ul>
        {%- if s.show_payment -%}
          {% render 'tba-image', image: s.payment_image, fallback: 'tba-afterpay.webp',
             alt: s.payment_alt, class: 'tba-footer__pay', width: 937, height: 327,
             url_width: 600, loading: 'lazy' %}
        {%- endif -%}
      </div>

    </div>

    <div class="tba-footer__bottom">
      <p style="margin:0">&copy; <span id="tba-year">{{ 'now' | date: '%Y' }}</span> {{ s.copyright }}</p>
      {%- if s.strapline != blank -%}<p style="margin:0">{{ s.strapline }}</p>{%- endif -%}
    </div>
  </div>
</footer>
</div>

{% schema %}
{
  "name": "TBA footer",
  "max_blocks": 4,
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Falls back to the theme logo, then to the bundled wordmark."
    },
    {
      "type": "text",
      "id": "brand_heading",
      "label": "Brand column heading",
      "default": "Tamarua Beauty Academy"
    },
    {
      "type": "textarea",
      "id": "blurb",
      "label": "Brand blurb",
      "default": "Industry based beauty training in Melbourne since 2010. On-site and live-online short courses in makeup, hair, nails, lashes, barbering, facials, waxing and spray tanning."
    },
    {
      "type": "text",
      "id": "facebook",
      "label": "Facebook URL",
      "default": "https://www.facebook.com/tamaruabeautyacademy/"
    },
    {
      "type": "text",
      "id": "instagram",
      "label": "Instagram URL",
      "default": "https://www.instagram.com/tamaruabeautyacademy"
    },
    {
      "type": "header",
      "content": "Contact column"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Heading",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "0421 864 557"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "info@tamaruabeautyacademy.com.au"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "Building 8/36 Aylesbury Dr,\nAltona VIC 3018"
    },
    {
      "type": "checkbox",
      "id": "show_payment",
      "label": "Show payment badge",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "payment_image",
      "label": "Payment badge"
    },
    {
      "type": "text",
      "id": "payment_alt",
      "label": "Payment badge alt text",
      "default": "Afterpay available"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright line",
      "default": "Tamarua Beauty Academy. All rights reserved."
    },
    {
      "type": "text",
      "id": "strapline",
      "label": "Strapline",
      "default": "Awarded Top 4 Education Facility in Australia — MAGAP (Asia Pacific)"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "links",
          "label": "Links",
          "info": "One per line, as: Label | /url"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TBA footer",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "heading": "TBA Courses",
            "links": "Make Up Courses | /collections/makeup-courses\nHairstyling Courses | /collections/hair-styling\nNail Courses | /collections/nails\nEyelash Extension Courses | /collections/eyelash-extensions\nBarbering Course | /products/barbering-on-site\nFacial Course | /products/facial-course-on-site-facials\nSpray Tanning Course | /products/spray-tanning-on-site-1-day-course"
          }
        },
        {
          "type": "column",
          "settings": {
            "heading": "Why TBA",
            "links": "About TBA | /pages/about-us\nOur Teachers | /pages/our-teachers\nStudent Success Stories | /pages/student-success-stories\nFAQ | /pages/faqs\nIntro to Beauty School Programs | /pages/intro-to-beauty-school-program"
          }
        },
        {
          "type": "column",
          "settings": {
            "heading": "Customer Information",
            "links": "FAQ's | /pages/faqs\nPrivacy Policy | /policies/privacy-policy\nRefund Policy (Products Only) | /policies/refund-policy\nWebsite Terms of Use | /policies/terms-of-service\nContact Us | /pages/contact-us"
          }
        }
      ]
    }
  ]
}
{% endschema %}
