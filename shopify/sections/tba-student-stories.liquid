{%- comment -%}
  Student success stories — three graduate cards, each one a block.
{%- endcomment -%}
{%- assign s = section.settings -%}
<div class="tba-scope">
<section class="tba-section" aria-labelledby="tba-stories-title">
  <div class="tba-shell">
    <div class="tba-center" style="margin-bottom:clamp(32px,3.8vw,52px)">
      {%- if s.eyebrow != blank -%}<p class="tba-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h2 class="tba-h-lg" id="tba-stories-title">{{ s.heading }}</h2>
      <hr class="tba-rule tba-rule--center">
    </div>
    <div class="tba-stories">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <article class="tba-story" {{ block.shopify_attributes }}>
          <figure>{% render 'tba-image', image: b.image, fallback: b.fallback, alt: b.alt,
             width: 400, height: 400, url_width: 800, loading: 'lazy' %}</figure>
          <h3>{{ b.name }}</h3>
          <p>{{ b.body }}</p>
          {%- if b.url != blank -%}
            <a class="tba-link-arrow" href="{{ b.url }}">{{ s.link_label }}
              <svg width="16" height="10" viewBox="0 0 16 10" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M0 5h14M10 1l4 4-4 4"/></svg></a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
</div>

{% schema %}
{
  "name": "TBA student stories",
  "max_blocks": 9,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Where our graduates are now"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Student Success Stories"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link text",
      "default": "Read More"
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Story"
        },
        {
          "type": "text",
          "id": "url",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "fallback",
          "label": "Bundled image",
          "info": "Filename in assets/ used when no image is chosen above."
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TBA student stories",
      "blocks": [
        {
          "type": "story",
          "settings": {
            "name": "Maria Nasrallah",
            "fallback": "tba-maria-nasrallah.webp",
            "alt": "Maria Nasrallah — Tamarua Beauty Academy student success story",
            "url": "/pages/maria-nasrallah-student-success-story",
            "body": "Maria says that the education that she received at the Tamarua Beauty Academy was amazing, and certainly helped her succeed in many forms. One of them being having her work published in three overseas publications using the skills that she learnt at the academy as well as opportunities to do more editorial work."
          }
        },
        {
          "type": "story",
          "settings": {
            "name": "Jolie Nguyen",
            "fallback": "tba-jolie-nguyen.jpg",
            "alt": "Jolie Nguyen — Tamarua Beauty Academy student success story",
            "url": "/pages/copy-of-student-success-story-maria",
            "body": "Jolie is a professional Hair & Makeup Artist based in the West side of Melbourne. After 5 years free-lancing, she has gained valuable experience and confidence to run her own business as \"Jolie Artistry\". Her business is all about providing Hair styling and Makeup Service for all clients for different special occasions from weddings to private celebrations."
          }
        },
        {
          "type": "story",
          "settings": {
            "name": "Sarah Meilak",
            "fallback": "tba-sarah-meilak.webp",
            "alt": "Sarah Meilak — Tamarua Beauty Academy student success story",
            "url": "/pages/copy-of-student-success-story-jolie",
            "body": "Sarah is the owner of \"Beauty By Sarah Meilak\" from the western suburbs. She has a great range of different beauty services including eyelash extensions, facials, hair and makeup. She says she decided to learn through the Tamarua Beauty Academy because of their amazing reputation, the small class sizes, the hands-on-learning and the education that is provided."
          }
        }
      ]
    }
  ]
}
{% endschema %}
