{%- comment -%}
  Enquiry form, in two layouts:

    standard — name, email, phone, service, preferred date, message.
    bridal   — the full wedding-day brief.

  Both post through Shopify's own contact form, so nothing extra is needed.
  To use an app form instead (Hulk Form Builder, say), set Form provider to
  "Custom embed code" and paste the embed in.

  NOTE ON FILE UPLOADS: Shopify's contact form cannot carry attachments. The
  bridal layout therefore asks for a link to inspiration images by default.
  Switching "Inspiration images" to "Upload box" renders the upload UI, but
  the files only actually go anywhere if you are using an app form.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign form_id = 'tba-' | append: section.id | append: '-form'
-%}
<div class="tba-scope">
<section class="tba-section {{ s.background }}" id="{{ s.anchor | default: 'enquire' }}">
  <div class="tba-shell">

    {%- if s.form_provider == 'custom' -%}
      <div class="tba-eform">
        <div class="tba-eform__head">
          {%- if s.ornament != blank -%}<p class="tba-eform__ornament">{{ s.ornament }}</p>{%- endif -%}
          <h2 class="tba-h-lg">{{ s.heading }}</h2>
          {%- if s.subheading != blank -%}<p>{{ s.subheading }}</p>{%- endif -%}
        </div>
        {{ s.form_embed }}
      </div>
    {%- else -%}
      {%- form 'contact', id: form_id, class: 'tba-eform', novalidate: 'novalidate' -%}
        <div class="tba-eform__head">
          {%- if s.ornament != blank -%}<p class="tba-eform__ornament">{{ s.ornament }}</p>{%- endif -%}
          <h2 class="tba-h-lg">{{ s.heading }}</h2>
          {%- if s.subheading != blank -%}<p>{{ s.subheading }}</p>{%- endif -%}
        </div>

        {%- if form.posted_successfully? -%}
          <p class="tba-eform__msg" role="status">{{ s.success }}</p>
        {%- elsif form.errors -%}
          <p class="tba-eform__msg" role="alert">{{ form.errors | default_errors }}</p>
        {%- endif -%}

        <div class="tba-eform__row">
          <label class="tba-efield">
            <span class="tba-efield__label"><span>First Name</span><span class="tba-efield__req">Required</span></span>
            <input type="text" name="contact[first_name]" placeholder="First name" autocomplete="given-name" required>
          </label>
          <label class="tba-efield">
            <span class="tba-efield__label"><span>Last Name</span><span class="tba-efield__req">Required</span></span>
            <input type="text" name="contact[last_name]" placeholder="Last name" autocomplete="family-name" required>
          </label>
        </div>

        <div class="tba-eform__row">
          <label class="tba-efield">
            <span class="tba-efield__label"><span>Email Address</span><span class="tba-efield__req">Required</span></span>
            <input type="email" name="contact[email]" placeholder="your@email.com" autocomplete="email" required>
          </label>
          <label class="tba-efield">
            <span class="tba-efield__label"><span>Phone Number</span><span class="tba-efield__req">Required</span></span>
            <input type="tel" name="contact[phone]" placeholder="Phone number" autocomplete="tel" required>
          </label>
        </div>

        {%- if s.layout == 'bridal' -%}

          <div class="tba-eform__row">
            <label class="tba-efield">
              <span class="tba-efield__label"><span>Wedding Date</span><span class="tba-efield__req">Required</span></span>
              <input type="date" name="contact[Wedding date]" required>
            </label>
            <label class="tba-efield">
              <span class="tba-efield__label"><span>Time of Ceremony</span><span class="tba-efield__req">Required</span></span>
              <input type="time" name="contact[Time of ceremony]" required>
            </label>
          </div>

          <label class="tba-efield">
            <span class="tba-efield__label"><span>Getting Ready Address</span><span class="tba-efield__req">Required</span></span>
            <input type="text" name="contact[Getting ready address]" required>
          </label>

          <label class="tba-efield">
            <span class="tba-efield__label"><span>Photographer Arrival Time?</span></span>
            <input type="time" name="contact[Photographer arrival time]">
          </label>

          <label class="tba-efield">
            <span class="tba-efield__label"><span>Ceremony Location</span><span class="tba-efield__req">Required</span></span>
            <textarea name="contact[Ceremony location]" class="tba-efield--tall" required></textarea>
          </label>

          <div class="tba-eform__row">
            <label class="tba-efield">
              <span class="tba-efield__label"><span>Who Requires Makeup?</span><span class="tba-efield__req">Required</span></span>
              <input type="text" name="contact[Who requires makeup]" required>
            </label>
            <label class="tba-efield">
              <span class="tba-efield__label"><span>Wedding Venue</span><span class="tba-efield__req">Required</span></span>
              <input type="text" name="contact[Wedding venue]" required>
            </label>
          </div>

          <label class="tba-efield">
            <span class="tba-efield__label"><span>Who Is Your Hair Stylist?</span><span class="tba-efield__req">Required</span></span>
            <input type="text" name="contact[Hair stylist]" required>
          </label>

          {%- if s.inspiration == 'upload' -%}
            <div class="tba-efield">
              <span class="tba-efield__label"><span>Inspiration Images</span></span>
              <label class="tba-edrop" data-tba-drop>
                <input type="file" name="contact[Inspiration images]" accept="image/png,image/jpeg,image/webp" multiple>
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="4" width="18" height="15" rx="2"/><path d="M3 15l4.5-4.5 3.5 3.5 3-3L21 16"/><circle cx="8.5" cy="8.5" r="1.4"/></svg>
                <b>{{ s.upload_label }}</b>
                <span>{{ s.upload_hint }}</span>
                <em>{{ s.upload_note }}</em>
              </label>
              <ul class="tba-efiles" data-tba-filelist></ul>
            </div>
          {%- else -%}
            <label class="tba-efield">
              <span class="tba-efield__label"><span>Inspiration Images</span></span>
              <input type="url" name="contact[Inspiration images]" placeholder="{{ s.inspiration_placeholder | escape }}">
            </label>
          {%- endif -%}

          <label class="tba-efield">
            <span class="tba-efield__label"><span>Anything Else You Would Like To Share?</span></span>
            <textarea name="contact[body]"></textarea>
          </label>

          {%- assign sources = s.sources | newline_to_br | split: '<br />' -%}
          {%- if sources.size > 0 -%}
            <div class="tba-efield">
              <span class="tba-efield__label"><span>Where Did You Hear About Me?</span><span class="tba-efield__req">Required</span></span>
              <div class="tba-eradios">
                {%- for source in sources -%}
                  {%- assign src = source | strip -%}
                  {%- if src != blank -%}
                    <label class="tba-eradio">
                      <input type="radio" name="contact[Heard about us]" value="{{ src | escape }}" required>
                      <span>{{ src }}</span>
                    </label>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

        {%- else -%}

          {%- assign services = s.services | newline_to_br | split: '<br />' -%}
          <div class="tba-eform__row">
            <label class="tba-efield">
              <span class="tba-efield__label"><span>Service of Interest</span><span class="tba-efield__req">Required</span></span>
              <select name="contact[Service of interest]" required>
                <option value="">Please select&hellip;</option>
                {%- for service in services -%}
                  {%- assign sv = service | strip -%}
                  {%- if sv != blank -%}<option>{{ sv }}</option>{%- endif -%}
                {%- endfor -%}
              </select>
            </label>
            <label class="tba-efield">
              <span class="tba-efield__label"><span>Preferred Date</span></span>
              <input type="date" name="contact[Preferred date]">
            </label>
          </div>

          <label class="tba-efield">
            <span class="tba-efield__label"><span>Message</span><span class="tba-efield__req">Required</span></span>
            <textarea name="contact[body]" required></textarea>
          </label>

        {%- endif -%}

        <button class="tba-btn tba-btn--gold" type="submit">{{ s.button }}</button>
        {%- if s.note != blank -%}<p class="tba-eform__note">{{ s.note }}</p>{%- endif -%}
      {%- endform -%}
    {%- endif -%}

  </div>
</section>
</div>

{% schema %}
{
  "name": "TBA enquiry form",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Form layout",
      "options": [
        {
          "value": "standard",
          "label": "Standard enquiry"
        },
        {
          "value": "bridal",
          "label": "Bridal enquiry"
        }
      ],
      "default": "standard"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Enquire"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "ornament",
      "label": "Ornament line",
      "info": "Small gold line above the heading, e.g. a symbol or short phrase."
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id",
      "default": "enquire"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        {
          "value": "",
          "label": "White"
        },
        {
          "value": "tba-section--cream",
          "label": "Cream"
        },
        {
          "value": "tba-section--blush",
          "label": "Blush"
        },
        {
          "value": "tba-section--sand",
          "label": "Sand"
        },
        {
          "value": "tba-section--feature",
          "label": "Feature — dark with gold glow"
        }
      ],
      "default": "tba-section--sand",
      "info": "\"Feature\" gives the section a dark ground, gold glow and an ivory card. Use it on the page you want people to convert on."
    },
    {
      "type": "text",
      "id": "button",
      "label": "Submit button",
      "default": "Send Enquiry"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Fine print",
      "default": "We'll only use your details to reply to your enquiry."
    },
    {
      "type": "text",
      "id": "success",
      "label": "Success message",
      "default": "Thank you — your enquiry is on its way. We'll be in touch shortly."
    },
    {
      "type": "header",
      "content": "Standard layout"
    },
    {
      "type": "textarea",
      "id": "services",
      "label": "Service options",
      "info": "One per line.",
      "default": "Spray Tan\nSpecial Occasion Makeup"
    },
    {
      "type": "header",
      "content": "Bridal layout"
    },
    {
      "type": "select",
      "id": "inspiration",
      "label": "Inspiration images",
      "options": [
        {
          "value": "link",
          "label": "Link field (works with Shopify's form)"
        },
        {
          "value": "upload",
          "label": "Upload box (needs an app form)"
        }
      ],
      "default": "link",
      "info": "Shopify's contact form cannot carry file attachments. Use the upload box only alongside a form app embed."
    },
    {
      "type": "text",
      "id": "inspiration_placeholder",
      "label": "Link field placeholder",
      "default": "Link to a Pinterest board, Instagram saves or shared album"
    },
    {
      "type": "text",
      "id": "upload_label",
      "label": "Upload box label",
      "default": "Click to upload images"
    },
    {
      "type": "text",
      "id": "upload_hint",
      "label": "Upload box hint",
      "default": "PNG, JPG, WebP up to 10MB each"
    },
    {
      "type": "text",
      "id": "upload_note",
      "label": "Upload box note",
      "default": "Multiple images supported"
    },
    {
      "type": "textarea",
      "id": "sources",
      "label": "\"Where did you hear about me?\" options",
      "info": "One per line.",
      "default": "Website\nInstagram\nFacebook\nReferral"
    },
    {
      "type": "header",
      "content": "Form provider"
    },
    {
      "type": "select",
      "id": "form_provider",
      "label": "Form provider",
      "options": [
        {
          "value": "shopify",
          "label": "Shopify contact form"
        },
        {
          "value": "custom",
          "label": "Custom embed code"
        }
      ],
      "default": "shopify"
    },
    {
      "type": "html",
      "id": "form_embed",
      "label": "Custom form embed",
      "info": "Only used when Form provider is Custom embed code."
    }
  ],
  "presets": [
    {
      "name": "TBA enquiry form"
    }
  ]
}
{% endschema %}
