          }
        },
        {
          "type": "review",
          "settings": {
            "name": "Jordon Beckwith",
            "when": "3 months ago",
            "body": "My daughter did the tweens holiday course and had a great time, and learnt a lot from Maggie. She wants to do more courses and continue to learn from Maggie at Tamarua Beauty Academy"
