{%- comment -%}
  Google reviews marquee. Each review is a block, so the whole set is editable
  in the theme editor, and every card is rendered server-side so the text is
  in the HTML for search engines. assets/tba-redesign.js clones the row once
  for the seamless loop and adds "Read more" to the cards that overflow.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign g_colors = "#4285F4,#EA4335,#FBBC05,#34A853" | split: "," -%}
<div class="tba-scope">
<section class="tba-reviews" aria-labelledby="tba-reviews-title">
  <div class="tba-shell">
    <div class="tba-reviews__head">
      {%- if s.eyebrow != blank -%}<p class="tba-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h2 class="tba-h-lg" id="tba-reviews-title">{{ s.heading }}</h2>
      <hr class="tba-rule tba-rule--center">

      <div class="tba-reviews__rating">
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M23 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.2a5.3 5.3 0 01-2.3 3.5v2.9h3.7c2.2-2 3.4-5 3.4-8.6z"/><path fill="#34A853" d="M12 24c3.1 0 5.7-1 7.6-2.8l-3.7-2.9c-1 .7-2.3 1.1-3.9 1.1-3 0-5.6-2-6.5-4.8H1.6v3C3.5 21.4 7.5 24 12 24z"/><path fill="#FBBC05" d="M5.5 14.6a7.2 7.2 0 010-4.6v-3H1.6a12 12 0 000 10.6l3.9-3z"/><path fill="#EA4335" d="M12 4.8c1.7 0 3.2.6 4.4 1.7l3.3-3.3C17.7 1.2 15.1 0 12 0 7.5 0 3.5 2.6 1.6 6.4l3.9 3C6.4 6.7 9 4.8 12 4.8z"/></svg>
        <span class="tba-reviews__score">{{ s.score }}</span>
        <span class="tba-stars tba-stars--lg" role="img" aria-label="Rated 5 out of 5 stars"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.6 5.6L21 8.5l-4.5 4.4 1.1 6.2L12 16.2 6.4 19.1l1.1-6.2L3 8.5l6.4-.9L12 2z"/></svg><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.6 5.6L21 8.5l-4.5 4.4 1.1 6.2L12 16.2 6.4 19.1l1.1-6.2L3 8.5l6.4-.9L12 2z"/></svg><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.6 5.6L21 8.5l-4.5 4.4 1.1 6.2L12 16.2 6.4 19.1l1.1-6.2L3 8.5l6.4-.9L12 2z"/></svg><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.6 5.6L21 8.5l-4.5 4.4 1.1 6.2L12 16.2 6.4 19.1l1.1-6.2L3 8.5l6.4-.9L12 2z"/></svg><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.6 5.6L21 8.5l-4.5 4.4 1.1 6.2L12 16.2 6.4 19.1l1.1-6.2L3 8.5l6.4-.9L12 2z"/></svg></span>
        <span class="tba-reviews__count">{{ s.count_prefix }} <b>{{ s.count }}</b></span>
      </div>
    </div>
  </div>
  <div class="tba-marquee">
    <div class="tba-marquee__track">
      {%- for block in section.blocks -%}
        {%- assign initial = block.settings.name | strip | slice: 0 | upcase -%}
        {%- assign ci = forloop.index0 | modulo: 4 -%}
        {%- assign colour = g_colors[ci] -%}
        <article class="tba-rcard" {{ block.shopify_attributes }}>
          <div class="tba-rcard__top">
            <span class="tba-rcard__avatar" aria-hidden="true" style="--tba-g-color:{{ colour }}">{{ initial }}</span>
            <div class="tba-rcard__who">
              <div class="tba-rcard__name">{{ block.settings.name }}</div>
              <div class="tba-rcard__when">{{ block.settings.when }}</div>
            </div>
            <svg class="tba-rcard__g" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M23 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.2a5.3 5.3 0 01-2.3 3.5v2.9h3.7c2.2-2 3.4-5 3.4-8.6z"/><path fill="#34A853" d="M12 24c3.1 0 5.7-1 7.6-2.8l-3.7-2.9c-1 .7-2.3 1.1-3.9 1.1-3 0-5.6-2-6.5-4.8H1.6v3C3.5 21.4 7.5 24 12 24z"/><path fill="#FBBC05" d="M5.5 14.6a7.2 7.2 0 010-4.6v-3H1.6a12 12 0 000 10.6l3.9-3z"/><path fill="#EA4335" d="M12 4.8c1.7 0 3.2.6 4.4 1.7l3.3-3.3C17.7 1.2 15.1 0 12 0 7.5 0 3.5 2.6 1.6 6.4l3.9 3C6.4 6.7 9 4.8 12 4.8z"/></svg>
          </div>
          <div class="tba-stars" role="img" aria-label="Rated 5 out of 5 stars"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.6 5.6L21 8.5l-4.5 4.4 1.1 6.2L12 16.2 6.4 19.1l1.1-6.2L3 8.5l6.4-.9L12 2z"/></svg><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.6 5.6L21 8.5l-4.5 4.4 1.1 6.2L12 16.2 6.4 19.1l1.1-6.2L3 8.5l6.4-.9L12 2z"/></svg><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.6 5.6L21 8.5l-4.5 4.4 1.1 6.2L12 16.2 6.4 19.1l1.1-6.2L3 8.5l6.4-.9L12 2z"/></svg><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.6 5.6L21 8.5l-4.5 4.4 1.1 6.2L12 16.2 6.4 19.1l1.1-6.2L3 8.5l6.4-.9L12 2z"/></svg><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.6 5.6L21 8.5l-4.5 4.4 1.1 6.2L12 16.2 6.4 19.1l1.1-6.2L3 8.5l6.4-.9L12 2z"/></svg></div>
          <p class="tba-rcard__body">{{ block.settings.body }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
</div>

{% schema %}
{
  "name": "TBA reviews",
  "max_blocks": 50,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Testimonials"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Students Say"
    },
    {
      "type": "text",
      "id": "score",
      "label": "Rating",
      "default": "5.0"
    },
    {
      "type": "text",
      "id": "count_prefix",
      "label": "Count prefix",
      "default": "Based on"
    },
    {
      "type": "text",
      "id": "count",
      "label": "Review count",
      "default": "88 reviews"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Reviewer name"
        },
        {
          "type": "text",
          "id": "when",
          "label": "When",
          "default": "a year ago"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Review"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TBA reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "name": "Qurat ul ain siddiqui",
            "when": "2 months ago",
            "body": "I had a wonderful experience at this makeup institute. Maggie was an amazing trainer — very talented, supportive, patient, and passionate about teaching. Her way of explaining makeup techniques was professional, creative, and easy to understand, which made learning enjoyable and inspiring. The classes were hands-on, well organised, and helped me improve my confidence and skills in both makeup and hairstyling. Maggie always encouraged students to do their best and created a welcoming learning environment. I would highly recommend this institute to anyone wanting to build a career in makeup, beauty, or hairstyling. It's a great place to learn, grow, and express creativity."
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "Anuradha Dharmadasa",
            "when": "4 months ago",
            "body": "I recently completed both the Nail and Makeup courses at Tamarua Beauty Academy, and I honestly couldn't be happier with my experience. Both courses were absolutely amazing and exceeded my expectations. The Nail course, taught by Thea, was so well structured. She is patient, supportive, and incredibly talented. I learned so much and felt confident every step of the way. The Makeup course with Maggie was just as incredible. She is knowledgeable, passionate, and made every lesson enjoyable and easy to follow. I've gained so many new skills that I can now confidently use. Thanks to this amazing training, I now run my own nail studio and hope to start makeup services as well very soon. A huge thank you to Thea and Maggie for their guidance, encouragement, and dedication. You both made this journey so special for me. I highly recommend Tamarua Beauty Academy to anyone who wants to start or grow in the beauty industry. Truly a wonderful learning experience!"
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "Apoorva Bhardwaj",
            "when": "5 months ago",
            "body": "I'm so grateful for my experience with Maggie at Tamarua Beauty School 💖 From the moment I started, Maggie was incredibly kind, supportive, and genuinely passionate about teaching. She creates such a welcoming environment that makes learning feel easy and enjoyable. This has honestly been the best beauty school I've attended. Maggie's knowledge is amazing — she explains everything so clearly and shares real, practical insights from the industry. I also loved that we worked with current, market-relevant products, which made the training feel very up-to-date and valuable. I had the best time learning makeup here, and I'm so glad I chose Tamarua Beauty School. I would highly recommend it to anyone looking to start or grow their journey in the beauty industry ✨"
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "Ashleigh Conibeer",
            "when": "4 months ago",
            "body": "Maggie was incredible and an exceptional teacher! I learn best through observation, and this course was ideal for me. Since completing it, I've had numerous work experience opportunities. I now run my own successful business and have received several awards in the industry. I've also connected with many wonderful students through TBA, and we collaborate now! I highly recommend this course."
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "kamal preet",
            "when": "10 months ago",
            "body": "I recently completed the makeup and hairstyling course at Tamarua Beauty Academy, and I must say, it was an incredible experience! I drove almost two hours each way from Rye for nearly three months, and it was absolutely worth it. Despite having closer academies, I knew this was the right place for me. A huge thank you to Maggie for her patience and exceptional skill level. The way she runs the business is truly impressive – she's a boss in every sense of the word! Additionally, my trainers, Maggie and Cassie, were both amazing and incredibly supportive throughout the course. For anyone considering a career in beauty, I highly recommend this school. I loved every moment of my time here! I also appreciated the flexibility they offered, especially when there were times I couldn't make it. They were more than accommodating, providing live streams and allowing me to come back to finish off classes. Thank you, thank you, thank you to everyone at Tamarua Beauty Academy!"
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "Jacqueline Mercieca",
            "when": "a year ago",
