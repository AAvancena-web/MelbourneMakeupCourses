{%- comment -%}
  FAQ accordion, built on <details>/<summary> — open/close needs no JavaScript
  and stays keyboard accessible and findable by in-page search.
{%- endcomment -%}
{%- assign s = section.settings -%}
<div class="tba-scope">
<section class="tba-section {{ s.background }}" {% if s.anchor != blank %}id="{{ s.anchor }}"{% endif %}>
  <div class="tba-shell">
    <div class="tba-center" style="margin-bottom:clamp(30px,3.4vw,48px)">
      {%- if s.eyebrow != blank -%}<p class="tba-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="tba-h-lg">{{ s.heading }}</h2>{%- endif -%}
      <hr class="tba-rule tba-rule--center">
    </div>
    <div class="tba-faq">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}{% if forloop.first and s.open_first %} open{% endif %}>
          <summary>{{ block.settings.question }}</summary>
          <div class="tba-faq__a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
</div>

{% schema %}
{
  "name": "TBA FAQ",
  "max_blocks": 16,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id",
      "default": "faq"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first question by default",
      "default": false
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        {
          "value": "",
          "label": "White"
        },
        {
          "value": "tba-section--cream",
          "label": "Cream"
        },
        {
          "value": "tba-section--blush",
          "label": "Blush"
        },
        {
          "value": "tba-section--sand",
          "label": "Sand"
        }
      ],
      "default": ""
    }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "info": "Basic HTML is allowed."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TBA FAQ"
    }
  ]
}
{% endschema %}
