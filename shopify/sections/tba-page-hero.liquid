{%- comment -%}
  Full-bleed page hero: image behind a dark veil, centred copy and buttons.
{%- endcomment -%}
{%- assign s = section.settings -%}
<div class="tba-scope">
<section class="tba-phero">
  {%- comment -%}
    A positive shift slides the photo right; the zoom that keeps the frame
    covered is twice the shift, so no bare edge is exposed on the other side.
  {%- endcomment -%}
  {%- assign shift = s.shift | default: 0 -%}
  {%- assign span = shift -%}
  {%- if span < 0 -%}{%- assign span = 0 | minus: shift -%}{%- endif -%}
  {%- assign zoom = span | times: 2 | plus: 100 | divided_by: 100.0 -%}
  <div class="tba-phero__media" style="--tba-phero-shift:{{ shift }}%;--tba-phero-zoom:{{ zoom }}{% if s.focus != blank %};--tba-phero-focus:{{ s.focus }}{% endif %}">
    {% render 'tba-image', image: s.image, fallback: s.fallback, alt: s.image_alt,
       width: s.width, height: s.height, url_width: 2000, fetchpriority: 'high' %}
  </div>
  <div class="tba-shell">
    <div class="tba-phero__inner">
      {%- if s.eyebrow != blank -%}<p class="tba-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h1 class="tba-h-xl">{{ s.heading }}</h1>
      <hr class="tba-rule tba-rule--center">
      {%- if s.body != blank -%}<p>{{ s.body }}</p>{%- endif -%}
      {%- if s.cta1_label != blank or s.cta2_label != blank -%}
        <div class="tba-btn-row">
          {%- if s.cta1_label != blank -%}
            <a class="tba-btn tba-btn--gold" href="{{ s.cta1_url | default: '#enquire' }}">{{ s.cta1_label }}</a>
          {%- endif -%}
          {%- if s.cta2_label != blank -%}
            <a class="tba-btn tba-btn--light" href="{{ s.cta2_url | default: '#' }}">{{ s.cta2_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
</div>

{% schema %}
{
  "name": "TBA page hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "fallback",
      "label": "Bundled image",
      "default": "tba-banner1.webp",
      "info": "Filename in Content > Files (or the theme's assets/) used when no image is chosen."
    },
    {
      "type": "text",
      "id": "width",
      "label": "Bundled image width",
      "default": "2000"
    },
    {
      "type": "text",
      "id": "height",
      "label": "Bundled image height",
      "default": "763"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text"
    },
    {
      "type": "range",
      "id": "shift",
      "label": "Move image sideways",
      "min": -30,
      "max": 30,
      "step": 1,
      "unit": "%",
      "default": 0,
      "info": "Positive moves the photo (and whoever is in it) to the right."
    },
    {
      "type": "text",
      "id": "focus",
      "label": "Image focus",
      "info": "CSS object-position, e.g. \"center 30%\" or \"30% center\". Lower the first value to move the subject right."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Intro"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "cta1_label",
      "label": "Primary button"
    },
    {
      "type": "text",
      "id": "cta1_url",
      "label": "Primary button link",
      "default": "#enquire"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Secondary button"
    },
    {
      "type": "text",
      "id": "cta2_url",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "TBA page hero"
    }
  ]
}
{% endschema %}
