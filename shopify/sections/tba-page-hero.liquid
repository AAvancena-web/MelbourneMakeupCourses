{%- comment -%}
  Full-bleed page hero: image behind a dark veil, centred copy and buttons.
{%- endcomment -%}
{%- assign s = section.settings -%}
<div class="tba-scope">
<section class="tba-phero">
  <div class="tba-phero__media">
    {% render 'tba-image', image: s.image, fallback: s.fallback, alt: s.image_alt,
       width: 2000, height: 763, url_width: 2000, fetchpriority: 'high' %}
  </div>
  <div class="tba-shell">
    <div class="tba-phero__inner">
      {%- if s.eyebrow != blank -%}<p class="tba-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h1 class="tba-h-xl">{{ s.heading }}</h1>
      <hr class="tba-rule tba-rule--center">
      {%- if s.body != blank -%}<p>{{ s.body }}</p>{%- endif -%}
      {%- if s.cta1_label != blank or s.cta2_label != blank -%}
        <div class="tba-btn-row">
          {%- if s.cta1_label != blank -%}
            <a class="tba-btn tba-btn--gold" href="{{ s.cta1_url | default: '#enquire' }}">{{ s.cta1_label }}</a>
          {%- endif -%}
          {%- if s.cta2_label != blank -%}
            <a class="tba-btn tba-btn--light" href="{{ s.cta2_url | default: '#' }}">{{ s.cta2_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
</div>

{% schema %}
{
  "name": "TBA page hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "fallback",
      "label": "Bundled image",
      "default": "tba-banner1.webp",
      "info": "Filename in Content > Files (or the theme's assets/) used when no image is chosen."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Intro"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "cta1_label",
      "label": "Primary button"
    },
    {
      "type": "text",
      "id": "cta1_url",
      "label": "Primary button link",
      "default": "#enquire"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Secondary button"
    },
    {
      "type": "text",
      "id": "cta2_url",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "TBA page hero"
    }
  ]
}
{% endschema %}
